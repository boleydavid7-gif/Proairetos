{
  "name": "proairetos",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src worker && oxlint --react-plugin -A all -D react-hooks/rules-of-hooks src",
    "check": "npm run lint && npm run typecheck && npm test",
    "smoke:visual": "node scripts/visual/smoke.mjs",
    "build:native": "VITE_API_BASE=https://proairetos.com VITE_MEDIA_BASE=https://proairetos.com vite build --mode native",
    "cap:sync": "npm run build:native && cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@fontsource/eb-garamond": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "capacitor-vision": "^0.0.16",
    "fflate": "^0.8.3",
    "ical.js": "^2.2.1",
    "maplibre-gl": "^5.24.0",
    "pdfjs-dist": "4.10.38",
    "postal-mime": "^2.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  }
}
