{
  "id": "/poreia/",
  "name": "Poreia by Proairetos",
  "short_name": "Poreia",
  "description": "A calm, local-first trip organizer for itineraries, bookings, packing, documents, spending, and time off.",
  "start_url": "/poreia/",
  "scope": "/poreia/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#071c24",
  "theme_color": "#071c24",
  "icons": [
    {
      "src": "/poreia/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/poreia/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/poreia/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/poreia/screenshots/narrow-1.webp",
      "sizes": "780x1688",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Poreia"
    },
    {
      "src": "/poreia/screenshots/narrow-2.webp",
      "sizes": "780x1688",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Poreia"
    },
    {
      "src": "/poreia/screenshots/wide-1.webp",
      "sizes": "1280x800",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Poreia"
    }
  ],
  "shortcuts": [
    {
      "name": "New trip",
      "short_name": "New trip",
      "url": "/poreia/?open=add",
      "icons": [
        {
          "src": "/poreia/icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Budget",
      "short_name": "Budget",
      "url": "/poreia/?open=budget",
      "icons": [
        {
          "src": "/poreia/icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Time off",
      "short_name": "Time off",
      "url": "/poreia/?open=time",
      "icons": [
        {
          "src": "/poreia/icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/poreia/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            "text/calendar",
            ".ics",
            "message/rfc822",
            ".eml",
            "text/plain",
            "text/html"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/poreia/?open=shared",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "text/calendar": [
          ".ics"
        ],
        "message/rfc822": [
          ".eml"
        ]
      }
    }
  ]
}
