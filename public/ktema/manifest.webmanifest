{
  "id": "/ktema/",
  "name": "Ktema by Proairetos",
  "short_name": "Ktema",
  "description": "Warranties, manuals and upkeep for your home, car and belongings.",
  "start_url": "/ktema/",
  "scope": "/ktema/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#12130f",
  "theme_color": "#12130f",
  "icons": [
    {
      "src": "/ktema/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/ktema/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/ktema/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/ktema/screenshots/narrow-1.webp",
      "sizes": "780x1688",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Ktema"
    },
    {
      "src": "/ktema/screenshots/narrow-2.webp",
      "sizes": "780x1688",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Ktema"
    },
    {
      "src": "/ktema/screenshots/wide-1.webp",
      "sizes": "1280x800",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Ktema"
    }
  ],
  "shortcuts": [
    {
      "name": "Coming up",
      "short_name": "Coming up",
      "url": "/ktema/?open=today",
      "icons": [
        {
          "src": "/ktema/icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Add a thing",
      "short_name": "Add",
      "url": "/ktema/?open=add",
      "icons": [
        {
          "src": "/ktema/icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/ktema/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf"
          ]
        }
      ]
    }
  }
}
