# Always check for a new service worker and app shell, so new versions arrive promptly.
# (Hashed files under /assets use Cloudflare's default revalidation. A year-long
# "immutable" rule is unsafe here: an unknown path serves the app page, which must
# never be cached as if it were a script.)
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
/askesis/sw.js
  Cache-Control: no-cache
/askesis/
  Cache-Control: no-cache
/askesis/index.html
  Cache-Control: no-cache
/oikonomia/sw.js
  Cache-Control: no-cache
/oikonomia/
  Cache-Control: no-cache
/hydros/sw.js
  Cache-Control: no-cache
/hydros/
  Cache-Control: no-cache
/hydros/index.html
  Cache-Control: no-cache

/praxis/manifest.webmanifest
  Cache-Control: no-cache
/praxis/index.html
  Cache-Control: no-cache
/theoria/manifest.webmanifest
  Cache-Control: no-cache
/theoria/
  Cache-Control: no-store, no-cache, must-revalidate
/theoria/index.html
  Cache-Control: no-store, no-cache, must-revalidate
