{
  // Cloudflare Worker that serves the built app. worker/index.ts only adds
  // /api/calendar, which passes calendar files through for "Other calendars".
  // Workers Builds: build command "npm run build", deploy command "npx wrangler deploy".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proairetos",
  "compatibility_date": "2026-09-30",
  "main": "worker/index.ts",
  // Public values only (ids, the project address and its publishable key); every secret stays a Worker secret.
  // Your own storage: the same Dropbox apps and OneDrive registration as Noesis; Google Drive's secret is the secret
  // GOOGLE_DRIVE_CLIENT_SECRET. SUPABASE_URL is the project's address (https://<ref>.supabase.co), never the key.
  "vars": {
    "DROPBOX_APP_KEY": "sx9m3fqvqa9s9oe",
    "DROPBOX_LIBRARY_APP_KEY": "tbhg85bu9g90114",
    "GOOGLE_DRIVE_CLIENT_ID": "486939287305-4uflkd132at87n3talvbgnec25sbn1r8.apps.googleusercontent.com",
    "ONEDRIVE_CLIENT_ID": "cff5be64-2952-42d0-a434-d569f62c7dd1",
    "SUPABASE_ANON_KEY": "sb_publishable_hmCwYBxhF7gC5GgKsx3slQ__syAYvhP",
    "SUPABASE_URL": "https://ccxkwfmybtouneurxunj.supabase.co"
  },
  // Variables set in the dashboard stay when this deploys.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the /api bridges (calendar, recipe, plant) run code; everything else is served as files.
    // Phyton identifies plants through Pl@ntNet with the secret PLANTNET_KEY (wrangler secret put PLANTNET_KEY).
    "run_worker_first": ["/api/*"],
    // The app has one page; any unknown path loads it.
    "not_found_handling": "single-page-application"
  }
}
